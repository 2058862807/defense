# Build artifacts too big for git - see circuits/ceremony/
build/
dist/
out/
circuits/build/
circuits/*/build/
**/build/
node_modules/

# Foundry - installed via `forge install`, not vendored (see docs/DEVELOPER.md)
lib/
cache/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
*.log
*.tmp
tmp/
temp/
# Large PTau files
*.ptau
*.ptau.*
# Keep final artifacts via LFS or separate storage
# circuits/build/*.wasm
# circuits/build/*.zkey
# But final small verifier is okay
!contracts/verifiers/*.sol
!circuits/build/verification_key.json
!circuits/build/circuit.hash
!circuits/build/combined.hash

# Models - large
models/*.joblib
models/*.npy
*.parquet

# OS
.DS_Store
Thumbs.db

