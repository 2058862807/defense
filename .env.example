# Copy to .env and fill secrets - NEVER commit .env
APP_NAME=protean-shapes
ENV=production
LOG_LEVEL=INFO
JWT_SECRET=your-RS256-public-key-or-HS256-secret-min-32-chars
JWT_ALGORITHM=RS256
JWT_AUD=protean-api
EVM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
EVM_PRIVATE_KEY=0x...
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
FLASHBOTS_SIGNING_KEY=0x...
FAIRNESS_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_RPC_URL=https://mev.api.blxr.org
REDIS_URL=redis://redis:6379/0
POSTGRES_URL=postgresql://protean:protean@postgres:5432/protean
KAFKA_BROKERS=kafka:9092
ZK_MODE=mock
ENABLE_PQC_ENCRYPTION=true
REQUIRE_ZK_PROOF=false
REDIS_PASS=change_me
POSTGRES_PASS=change_me
