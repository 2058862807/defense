# PROTEAN DEFENSE - Enterprise Government Standard - .env.example
# Copy to .env and fill secrets - NEVER commit .env
# Government Standard: FIPS 140-3, SLSA L3, all secrets via Vault in production, .env for dev only

# --- App ---
APP_NAME=protean-defense
ENV=production
LOG_LEVEL=INFO
API_PORT=8080

# --- Security / JWT - RS256 via JWKS ---
JWT_JWKS_URL=https://auth.protean.sh/.well-known/jwks.json
JWT_ALGORITHM=RS256
JWT_AUD=protean-api
JWT_ISSUER=https://auth.protean.sh
# Legacy HS256 secret for dev fallback only (never in prod)
JWT_SECRET=your-RS256-public-key-or-HS256-secret-min-32-chars
BCRYPT_ROUNDS=12

# --- EVM / MEV - Real Mainnet ---
EVM_RPC_URL=https://ethereum.publicnode.com # Free public RPC - no API key required, or use Alchemy/Infura with API key from Vault: https://mainnet.infura.io/v3/YOUR_KEY
EVM_WS_URL=wss://ethereum.publicnode.com # Free public WSS - no API key, or use Alchemy/Infura: wss://mainnet.infura.io/ws/v3/YOUR_KEY
EVM_CHAIN_ID=1
# Signer keys are NEVER in .env. Local/pilot: put EVM_PRIVATE_KEY and
# FLASHBOTS_SIGNING_KEY in data/local_secrets.env (0600, git-ignored, sourced by
# scripts/start_stack.sh). Production: Vault only (secret/data/prod/evm-signer,
# secret/data/prod/flashbots-auth). Bank pilot pre-HSM posture:
#   HSM_REQUIRE_HARDWARE=false   # real software custody, audited loudly; Tier 1 = hardware HSM
HSM_REQUIRE_HARDWARE=true
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
FAIRNESS_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
FAIRNESS_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_RPC_URL=https://mev.api.blxr.org

# --- Vault (HSM via Cloud Service) ---
VAULT_ADDR=https://vault.protean.sh
VAULT_ROLE_ID=protean-prod-role-id
VAULT_SECRET_ID=change_me_vault_secret_id
VAULT_KV_PATH_SIGNER=secret/data/prod/evm-signer
VAULT_KV_PATH_FLASHBOTS=secret/data/prod/flashbots-auth

# --- Infra - Real Production ---
REDIS_URL=rediss://redis:6380/0
REDIS_PASS=CHANGEME_VIA_VAULT__GENERATE_RANDOM_32_CHARS__DO_NOT_USE_DEFAULT
REDIS_TLS_REQUIRED=true
POSTGRES_URL=postgresql://protean:protean@postgres:5432/protean?sslmode=require
POSTGRES_PASS=CHANGEME_VIA_VAULT__GENERATE_RANDOM_32_CHARS__DO_NOT_USE_DEFAULT
POSTGRES_TLS_REQUIRED=true
KAFKA_BROKERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_TOPIC_MEV=prod.mev-opportunities
KAFKA_TOPIC_RISK=prod.risk-scores

# --- Metered Token Licensing (C1) - fixed-pool 6-month pilot grant ---
METERING_DB_PATH=data/metering.db
METERING_PILOT_MONTHS=6
METERING_PILOT_TOKEN_POOL=1000000
METERING_TOKEN_COST_ANALYZE=1
METERING_TOKEN_COST_COMPLIANCE=1
METERING_LICENSE_PRICE_USD_CENTS=50000
METERING_LICENSE_DISPLAY_CURRENCY=USD
METERING_PAYMENT_WEBHOOK_URL=
METERING_PAYMENT_WEBHOOK_SECRET=
METERING_AUDIT_PERIOD_DAYS=1
# On-chain usage audit registry on Polygon (set after deploy_usage_audit.py):
METERING_USAGE_REGISTRY_ADDRESS=

# --- ZK - Real Groth16 in-process (CircuitIngestor + snarkjs), No Fallback in Prod ---
# No ZK_PROVER_URL / ZK_VERIFIER_URL: proving+verification run in-process.
ZK_CIRCUIT_PATH_WASM=circuits/final_artifacts/fairness_policy.wasm
ZK_CIRCUIT_PATH_ZKEY=circuits/final_artifacts/fairness_policy_final.zkey
ZK_VERIFICATION_KEY_PATH=circuits/final_artifacts/verification_key.json
# Combined SHA256(wasm || zkey) of circuits/final_artifacts/ - SLSA provenance
ZK_CIRCUIT_HASH=d80e39879037cddf0694ee59d1b6d21d1a9fa386196564732a19245363100b41
ZK_MODE=production
ZK_FALLBACK_ENABLED=false
REQUIRE_ZK_PROOF=true

# --- Automation (fully autonomous operation) ---
# Auto-arm bots at startup (fail-closed: OFF by default)
BOT_AUTOSTART_OFFENSE=false
BOT_AUTOSTART_DEFENSE=false
BOT_AUTOSTART_FOCUS=auto
# Slack-compatible alert webhook. Leave empty to disable alerts.
ALERT_WEBHOOK_URL=
# Full KMS rotation once keys are older than N days (0 = disabled)
KMS_ROTATION_DAYS=90
# Periodic proof audit: re-verify completed proofs with snarkjs groth16 verify
PROOF_AUDIT_INTERVAL_MINUTES=30
PROOF_AUDIT_REVERIFY_COUNT=10

# --- PQC - ML-KEM FIPS 203 ---
LIBOQS_LIB_PATH=/usr/local/lib/liboqs.so
ML_KEM_VARIANT=ML-KEM-768
LIBOQS_MIN_VERSION=0.12.0

# --- Circuit Breaker ---
CB_FAIL_MAX=3
CB_RESET_TIMEOUT=120

# --- Policy ---
FAIRNESS_POLICY_VERSION=1.2.0
# Policy JSON: max_slippage_bps 50, disallow_sandwich_small_users true, min 1 ETH, allow_arbitrage true, allow_liquidation true, allow_sandwich false, protected_routers

# --- Compliance - GAP1 Real OFAC/FATF Live Feeds ---
OFAC_FEED_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.CSV
OFAC_LEGACY_URL=https://www.treasury.gov/ofac/downloads/sdn.csv
FATF_FEED_URL=https://www.fatf-gafi.org/en/publications/High-risk-and-other-monitored-jurisdictions.html
FATF_BLACK_URL=https://www.fatf-gafi.org/en/publications/High-risk-and-other-monitored-jurisdictions/Call-for-action.html
OFAC_CACHE_TTL=86400
FATF_CACHE_TTL=86400

# --- QRNG - GAP2 Real Cloud QRNG ---
# Qrypt Quantum Entropy Service - Free tier 1,000 req/day - US ORNL+Los Alamos
QRYPT_API_TOKEN=your_qrypt_free_tier_token_1000_per_day
QRYPT_ENDPOINT=https://api-eus.qrypt.com
# Azure Quantum QRNG - Free tier 10,000 req/month - Q# Hadamard Quantinuum/IonQ
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_RESOURCE_GROUP=your_resource_group
AZURE_QUANTUM_WORKSPACE=your_quantum_workspace
AZURE_LOCATION=eastus
AZURE_QUANTUM_CONNECTION_STRING=your_connection_string
# AWS Braket QRNG - via Marketplace or direct - IonQ Aria-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_BRAKET_DEVICE_ARN=arn:aws:braket:::device/qpu/ionq/Aria-1
QRYPT_AWS_MARKETPLACE_TOKEN=your_qrypt_aws_marketplace_token

# --- HSM - GAP3 Real Cloud HSM ---
# AWS CloudHSM - Free tier 1 HSM 30 days - FIPS 140-2 Level 3
AWS_CLOUDHSM_CLUSTER_ID=your_cloudhsm_cluster_id
AWS_CLOUDHSM_USER=crypto_user
AWS_CLOUDHSM_PASSWORD=change_me
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:xxx:key/yyy
PKCS11_LIB=/opt/cloudhsm/lib/libcloudhsm_pkcs11.so
HSM_TOKEN_LABEL=cavium
# GCP Cloud HSM - Free tier 10,000 ops/month - FIPS 140-2 Level 3
GCP_PROJECT_ID=your_gcp_project_id
GCP_KMS_LOCATION=us-east1
GCP_KMS_KEY_RING=protean-ring
GCP_KMS_KEY_ID=protean-hsm-key
# Securosys CloudHSM - Free tier 1,000 ops/month - Swiss EAL4+
SECUROSYS_API_URL=https://us.securosys.cloud/api/v1
SECUROSYS_AUTH_TOKEN=your_securosys_token
SECUROSYS_KEY_LABEL=protean-hsm-key

# --- Compliance & Production Hardening ---
ENFORCE_HASHES=true
ENABLE_PQC_ENCRYPTION=true
ENABLE_MTLS=true
SIEM_ENDPOINT=https://siem.protean.sh/api/logs
OTEL_ENDPOINT=https://otel.protean.sh/api/traces

# --- Load Testing - GAP4 ---
LOAD_TEST_HOST=http://localhost:8080
LOAD_TEST_TPS=100000
LOAD_TEST_DURATION=30
LOCUST_USERS=1000
K6_VUS=1000

# --- Monitoring - GAP5 ---
GRAFANA_ADMIN_PASS=change_me_grafana_admin
PROMETHEUS_RETENTION=30d
GRAFANA_CLOUD_API_KEY=your_grafana_cloud_10k_metrics_free

# --- ZK Compute - SaladCloud $5 free credits ---
SALAD_API_KEY=your_saladcloud_5_dollars_free
SALAD_ORG_ID=...

# --- Deployment - AWS EKS 750 hrs/month free ---
AWS_EKS_CLUSTER_NAME=protean-prod
AWS_EKS_REGION=us-east-1
EKS_NODE_TYPE=t3.medium

# --- Licensing - GAP8 ---
LICENSE_PATH=./licenses/enterprise.license.json
LICENSE_PUBKEY_PATH=./licenses/licensing_pubkey.pem
LICENSE_SERVER_URL=http://licensing:8085
LICENSE_PRIVATE_KEY_PATH=./licenses/licensing_private.pem

# --- Connector - GAP8 ---
CONNECTOR_PORT=8081
GRPC_PORT=50051
CONNECTOR_HOST=0.0.0.0

# --- Portal - GAP8 Customer Explanation Portal ---
PORTAL_PORT=3000
REACT_APP_API_URL=http://localhost:8080
REACT_APP_CONNECTOR_URL=http://localhost:8081
REACT_APP_LICENSING_URL=http://localhost:8085

# --- Pilot runtime credentials (optional) ---
# The pilot / operator can instead enter these once at runtime via the admin
# API (gov-admin) - POST /pilot/credentials/{field}. Values persist encrypted
# in data/secrets.enc (AES-256-GCM under SECRETS_MASTER_KEY) and apply without
# a restart. Environment variables always win over the store when both exist.
SECRETS_MASTER_KEY=change_me_16_chars_min
CHAINALYSIS_API_TOKEN=
TRM_API_TOKEN=
# Flashbots auth signer + gas wallet can also be supplied via the pilot API:
#   flashbots_signing_key, evm_private_key
