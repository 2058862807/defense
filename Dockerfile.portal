# Dockerfile for Customer Explanation Portal - Government Standard
# React portal for tiered disclosure Customer/Regulator/Audit views
#
# NOTE: portal/ does not yet contain a real React app (no package.json/src).
# This build is expected to fail until that app exists - that is correct
# behavior. Do not add a placeholder-page fallback here; a failed portal
# build must fail the image build, not ship a fake "production ready" page.

FROM node:20-bullseye as builder

WORKDIR /portal

COPY portal/package.json portal/package-lock.json* ./
RUN npm install

COPY portal/ ./
RUN npm run build

FROM nginx:alpine

COPY --from=builder /portal/build /usr/share/nginx/html
COPY portal/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
